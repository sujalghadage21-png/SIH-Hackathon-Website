# ============================================================
# RESCUE-ZONE AI — Environment Variables
# ============================================================
# IMPORTANT: Copy this file to .env.local (never commit .env.local)
# All VITE_ prefixed variables are exposed to the frontend bundle.
# Do NOT store secret backend keys here — use a backend proxy instead.
#
# ⚠️  NEVER commit .env.local or .env to version control.
# ============================================================

# --- Map Tile Services (currently using free public endpoints, no key needed) ---
# If you switch to a paid Mapbox/MapTiler token, set it here:
# VITE_MAPBOX_TOKEN=your_mapbox_token_here
# VITE_MAPTILER_KEY=your_maptiler_key_here

# --- ISRO Bhuvan API (future integration) ---
# VITE_BHUVAN_API_KEY=your_bhuvan_api_key_here

# --- IMD Weather API (future integration) ---
# VITE_IMD_API_KEY=your_imd_api_key_here

# --- AI/ML Backend Endpoint (future integration) ---
# VITE_AI_BACKEND_URL=https://your-backend-api.com
# VITE_AI_BACKEND_KEY=your_backend_api_key_here

# --- Firebase / Supabase (future real-time data) ---
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
